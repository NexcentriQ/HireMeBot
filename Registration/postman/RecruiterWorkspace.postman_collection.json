            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(() => {",
                  "  pm.test('401 (API Gateway {message:Unauthorized} or the Lambda\\'s UNAUTHORIZED)', () => {",
                  "    pm.response.to.have.status(401);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.error === 'UNAUTHORIZED' || json.message === 'Unauthorized').to.eql(true);",
                  "  });",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "Recruiter still PENDING approval (403)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{BASE_URL}}/api/v1/recruiter/students",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{COGNITO_ACCESS_TOKEN_PENDING}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(() => {",
                  "  if (!pm.variables.get('COGNITO_ACCESS_TOKEN_PENDING')) {",
                  "    pm.test.skip('Set COGNITO_ACCESS_TOKEN_PENDING to run this request');",
                  "    return;",
                  "  }",
                  "  pm.test('403 FORBIDDEN: pending recruiter', () => {",
                  "    pm.response.to.have.status(403);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(false);",
                  "    pm.expect(json.error).to.eql('FORBIDDEN');",
                  "    pm.expect(json.message).to.be.a('string');",
                  "  });",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "Student account token (403)",
          "request": {
            "method": "GET",
            "header": [],
