    {
      "name": "3. POST documents/upload-url and register",
      "item": [
        {
          "name": "upload-url for an assigned student (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{BASE_URL}}/api/v1/documents/upload-url",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{COGNITO_ACCESS_TOKEN}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": {{STUDENT_ID}},\n  \"documentType\": \"RESUME\",\n  \"fileName\": \"Postman_Resume.pdf\",\n  \"contentType\": \"application/pdf\",\n  \"fileSize\": 245760,\n  \"checksum\": \"{{postmanChecksum}}\"\n}"
            },
            "description": "Needs a real S3 bucket behind the Lambda. The response contains a presigned URL: never paste it anywhere."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('postmanChecksum', CryptoJS.SHA256(pm.variables.replaceIn('{{$guid}}')).toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(() => {",
                  "  if (!pm.variables.get('STUDENT_ID')) {",
                  "    pm.test.skip('Set STUDENT_ID to run this request');",
                  "    return;",
                  "  }",
                  "  pm.test('200, an upload is required (a fresh checksum each run)', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().success).to.eql(true);",
                  "    pm.expect(pm.response.json().status).to.eql('UPLOAD_REQUIRED');",
                  "  });",
                  "})();"
                ]
              }
            }
          ]
        },
