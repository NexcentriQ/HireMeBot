# Placeholders only. Copy to .env (git-ignored) for tools that read a .env file, or use env.json for `sam local`.
# Never commit real credentials.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=hiremebot_db_V1
DB_USERNAME=<db user>
DB_PASSWORD=<db password>

# VERIFY_IDENTITY (default) for hosted databases; DISABLED only for a local MySQL without TLS.
DB_SSL_MODE=VERIFY_IDENTITY
# Only for providers with a private CA (e.g. Aiven): a PKCS12/JKS truststore holding the CA certificate.
# DB_TRUSTSTORE_URL=file:/path/to/truststore.p12
# DB_TRUSTSTORE_PASSWORD=<truststore password>
# DB_TRUSTSTORE_TYPE=PKCS12

# Time zone that defines a "calendar day" for the student endpoint (default America/Chicago).
APP_TIMEZONE=America/Chicago

# Development-only headers. NOT authentication. Keep false anywhere that is not your own machine.
ALLOW_DEV_RECRUITER_HEADER=false
ALLOW_DEV_STUDENT_HEADER=false

# Set to true to run the database integration tests (they write to, then clean up in, the database above).
# RUN_DB_TESTS=true

{
  "RecruiterFunction": {
    "DB_HOST": "host.docker.internal",
    "DB_PORT": "3306",
    "DB_NAME": "",
    "DB_USERNAME": "",
    "DB_PASSWORD": "",
    "DB_SSL_MODE": "DISABLED",
    "ALLOW_DEV_RECRUITER_HEADER": "true"
  },
  "StudentFunction": {
    "DB_HOST": "host.docker.internal",
    "DB_PORT": "3306",
    "DB_NAME": "",
    "DB_USERNAME": "",
    "DB_PASSWORD": "",
    "DB_SSL_MODE": "DISABLED",
    "APP_TIMEZONE": "America/Chicago",
    "ALLOW_DEV_STUDENT_HEADER": "true"
  }
}

